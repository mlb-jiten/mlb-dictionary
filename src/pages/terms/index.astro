---
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection } from 'astro:content';

import SiteFooter from '../../components/SiteFooter.astro';

const entries = await getCollection('terms');

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const numbers = '123456789'.split('');

const kana = [
    'あ', 'い', 'う', 'え', 'お',
    'か', 'き', 'く', 'け', 'こ',
    'さ', 'し', 'す', 'せ', 'そ',
    'た', 'ち', 'つ', 'て', 'と',
    'な', 'に', 'ぬ', 'ね', 'の',
    'は', 'ひ', 'ふ', 'へ', 'ほ',
    'ま', 'み', 'む', 'め', 'も',
    'や', 'ゆ', 'よ',
    'ら', 'り', 'る', 'れ', 'ろ',
    'わ', 'を', 'ん',
];

const indexKeys = [
    ...letters,
    ...numbers,
    ...kana,
];

function getDisplayName(title: string) {
    return title.replace(/とは[？?]$/, '').trim();
}

function normalizeKana(value: string) {
    const map: Record<string, string> = {
        'が': 'か',
        'ぎ': 'き',
        'ぐ': 'く',
        'げ': 'け',
        'ご': 'こ',

        'ざ': 'さ',
        'じ': 'し',
        'ず': 'す',
        'ぜ': 'せ',
        'ぞ': 'そ',

        'だ': 'た',
        'ぢ': 'ち',
        'づ': 'つ',
        'で': 'て',
        'ど': 'と',

        'ば': 'は',
        'び': 'ひ',
        'ぶ': 'ふ',
        'べ': 'へ',
        'ぼ': 'ほ',

        'ぱ': 'は',
        'ぴ': 'ひ',
        'ぷ': 'ふ',
        'ぺ': 'へ',
        'ぽ': 'ほ',

        'ぁ': 'あ',
        'ぃ': 'い',
        'ぅ': 'う',
        'ぇ': 'え',
        'ぉ': 'お',

        'ゃ': 'や',
        'ゅ': 'ゆ',
        'ょ': 'よ',

        'っ': 'つ',
    };

    return map[value] ?? value;
}

const terms = entries
    .map((entry) => {
        const name = getDisplayName(entry.data.title);

        return {
            id: entry.id,
            name,
            english: entry.data.english ?? '',
            description: entry.data.description,
            reading: entry.data.reading,
        };
    })
    .sort((a, b) =>
        a.reading.localeCompare(b.reading, 'ja')
    );

function getIndexes(term: (typeof terms)[number]) {
    const indexes = new Set<string>();

    const firstCharacter = term.name.charAt(0);

    // 英字で始まる用語
    if (/^[A-Za-z]$/.test(firstCharacter)) {
        indexes.add(firstCharacter.toUpperCase());
    }

    // 数字で始まる用語
    if (/^[1-9]$/.test(firstCharacter)) {
        indexes.add(firstCharacter);
    }

    // 日本語を含む用語は「読み」からも探せるようにする
    const containsJapanese = /[ぁ-んァ-ヶ一-龯々]/.test(term.name);

    if (containsJapanese && term.reading) {
        const firstReading = normalizeKana(
            term.reading.trim().charAt(0)
        );

        if (kana.includes(firstReading)) {
            indexes.add(firstReading);
        }
    }

    return [...indexes];
}

const indexedTerms = indexKeys.map((key) => ({
    key,
    terms: terms.filter((term) =>
        getIndexes(term).includes(key)
    ),
}));


---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="MLB用語辞典に掲載している用語を、英字・数字・五十音から探せます。"
        />
        <title>用語索引 | MLB用語辞典</title>
    </head>

    <body>
        <SiteHeader />

        <main class="container">
            <p class="breadcrumb">
                <a href="/">MLB用語辞典</a>
                <span>›</span>
                用語索引
            </p>

            <section class="intro">
                <p class="eyebrow">INDEX</p>
                <h1>用語索引</h1>

                <p>
                    MLB用語辞典に掲載している用語を、
                    英字・数字・五十音から探せます。
                </p>

                <p class="term-count">
                    掲載用語：{terms.length}語
                </p>

                <p class="category-link">
                    <a href="/categories/">カテゴリから探す →</a>
                </p>
            </section>

            <section class="index-navigation">
                <div class="index-row">
                    <p class="index-label">英字</p>

                    <div class="index-buttons">
                        {letters.map((key) => {
                            const hasTerms = indexedTerms
                                .find((group) => group.key === key)
                                ?.terms.length;

                            return hasTerms ? (
                                <a href={`/terms/index/${key}/`}>
                                    {key}
                                </a>
                            ) : (
                                <span>{key}</span>
                            );
                        })}
                    </div>
                </div>

                <div class="index-row">
                    <p class="index-label">数字</p>

                    <div class="index-buttons">
                        {numbers.map((key) => {
                            const hasTerms = indexedTerms
                                .find((group) => group.key === key)
                                ?.terms.length;

                            return hasTerms ? (
                                <a href={`/terms/index/${key}/`}>
                                    {key}
                                </a>
                            ) : (
                                <span>{key}</span>
                            );
                        })}
                    </div>
                </div>

                <div class="index-row">
                    <p class="index-label">五十音</p>

                    <div class="index-buttons kana-buttons">
                        {kana.map((key) => {
                            const hasTerms = indexedTerms
                                .find((group) => group.key === key)
                                ?.terms.length;

                            return hasTerms ? (
                                <a href={`/terms/index/${key}/`}>
                                    {key}
                                </a>
                            ) : (
                                <span>{key}</span>
                            );
                        })}
                    </div>
                </div>
            </section>

        </main>
        <SiteFooter />
    </body>
</html>

<style>
    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background: #f6f8fb;
        color: #172033;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
            "Noto Sans JP", sans-serif;
        line-height: 1.8;
    }

    .container {
        width: min(1000px, calc(100% - 40px));
        margin: 0 auto;
    }

    header {
        padding: 18px 0;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
    }

    .site-title {
        color: #17365d;
        font-size: 20px;
        font-weight: 700;
        text-decoration: none;
    }

    main {
        padding: 28px 0 70px;
    }

    .breadcrumb {
        margin: 0 0 28px;
        color: #64748b;
        font-size: 13px;
    }

    .breadcrumb a {
        color: #476b95;
        text-decoration: none;
    }

    .breadcrumb span {
        margin: 0 8px;
    }

    .intro {
        margin-bottom: 32px;
    }

    .eyebrow {
        margin: 0 0 6px;
        color: #476b95;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
    }

    h1 {
        margin: 0 0 12px;
        font-size: 36px;
    }

    .intro > p:not(.eyebrow):not(.term-count) {
        margin: 0;
        color: #566176;
    }

    .term-count {
        margin: 10px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .index-navigation {
        margin-bottom: 48px;
        padding: 24px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .index-row + .index-row {
        margin-top: 22px;
    }

    .index-label {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 700;
    }

    .index-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .index-buttons a,
    .index-buttons span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 6px;
        font-size: 14px;
    }

    .index-buttons a {
        background: #eaf2f9;
        color: #214f7d;
        font-weight: 700;
        text-decoration: none;
    }

    .index-buttons a:hover {
        background: #dce9f4;
    }

    .index-buttons span {
        background: #f3f4f6;
        color: #b2b8c1;
    }

    .index-section {
        margin-bottom: 44px;
        scroll-margin-top: 20px;
    }

    .index-section h2 {
        margin: 0 0 14px;
        padding-bottom: 8px;
        border-bottom: 2px solid #17365d;
        font-size: 24px;
    }

    .term-list {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .term-item {
        display: block;
        padding: 20px 24px;
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid #e8edf3;
    }

    .term-item:last-child {
        border-bottom: 0;
    }

    .term-item:hover {
        background: #f8fafc;
    }

    .term-heading {
        display: flex;
        align-items: baseline;
        gap: 14px;
        margin-bottom: 5px;
    }

    .term-heading h3 {
        margin: 0;
        color: #17365d;
        font-size: 18px;
    }

    .english {
        color: #8791a1;
        font-size: 13px;
    }

    .term-item p {
        margin: 0;
        color: #566176;
        font-size: 14px;
    }

    @media (max-width: 650px) {
        .kana-buttons {
            display: grid;
            grid-template-columns: repeat(5, 44px);
            gap: 8px;
        }

             .kana-buttons > :nth-child(39),
                .kana-buttons > :nth-child(44) {
                grid-column: 1;
            }

        .container {
            width: min(100% - 28px, 1000px);
        }

        h1 {
            font-size: 30px;
        }

        .index-navigation {
            padding: 18px;
        }

        .term-item {
            padding: 18px;
        }

        .term-heading {
            display: block;
        }

        .english {
            display: block;
            margin-top: 2px;
        }

        .index-buttons {
    gap: 8px;
}

.index-buttons a,
.index-buttons span {
    width: 44px;
    height: 44px;
    font-size: 15px;
}
    }
</style>