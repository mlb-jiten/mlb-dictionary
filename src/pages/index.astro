---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const entries = await getCollection('terms');

const terms = entries.map((entry) => ({
    name: entry.data.title.replace('とは？', ''),
    fullName: entry.data.english ?? '',
    description: entry.data.description,
    href: `/terms/${entry.id}/`,
}));
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>MLB用語辞典</title>
	
    	<meta name="google-site-verification" content="Vz3r4X0xFtGDWPKcQ9Tk9KguubOqMj6GyBPve50My90" />
		<meta
    		name="description"
   			content="MLBに関する用語を分かりやすく解説する辞典です。"
		/>
	</head>

	<body>
		<SiteHeader />

		<main class="container">
			<section class="hero">
				<p class="eyebrow">MLB DICTIONARY</p>
				<h1>MLB用語辞典</h1>
				<p class="intro">
					MLBに関する用語を分かりやすく解説します。
				</p>


		<form class="home-search-form" action="/search/" method="get">
    		<input
       		 class="search"
       		 type="search"
        		name="q"
        		placeholder="用語を検索"
        		aria-label="MLB用語を検索"
        		required
    		/>
    		<button type="submit">検索</button>
		</form>

			</section>

			<section>
				<div class="section-heading">
					<h2>用語を探す</h2>
					<span>{terms.length} TERMS</span>
				</div>

<div class="term-grid">
	{terms.map((term) => (
		term.href ? (
			<a class="term-card term-link" href={term.href}>
				<h3>{term.name}</h3>
				<p class="english">{term.fullName}</p>
				<p>{term.description}</p>
			</a>
		) : (
			<article class="term-card">
				<h3>{term.name}</h3>
				<p class="english">{term.fullName}</p>
				<p>{term.description}</p>
			</article>
		)
	))}
</div>
			</section>
		</main>

		<SiteFooter />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family:
			-apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP",
			sans-serif;
		color: #172033;
		background: #f6f8fb;
		line-height: 1.7;
	}

	.container {
		width: min(1080px, calc(100% - 40px));
		margin: 0 auto;
	}

	header {
		background: #ffffff;
		border-bottom: 1px solid #e2e7ef;
		padding: 18px 0;
	}

	.site-title {
		color: #13294b;
		font-size: 20px;
		font-weight: 800;
		text-decoration: none;
	}

	.hero {
		padding: 90px 0 70px;
		max-width: 780px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: #47658f;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	h1 {
		margin: 0;
		color: #13294b;
		font-size: clamp(38px, 6vw, 64px);
		line-height: 1.18;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 680px;
		margin: 24px 0 30px;
		color: #566176;
		font-size: 17px;
	}

	.search {
		width: 100%;
		max-width: 620px;
		padding: 17px 20px;
		border: 1px solid #ccd4df;
		border-radius: 10px;
		background: #ffffff;
		font-size: 16px;
		outline: none;
	}

	.search:focus {
		border-color: #47658f;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 20px;
		border-bottom: 2px solid #13294b;
	}

	h2 {
		margin: 0 0 12px;
		font-size: 25px;
	}

	.section-heading span {
		color: #7a8495;
		font-size: 12px;
		font-weight: 700;
	}

	.term-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		padding-bottom: 80px;
	}

	.term-card {
		padding: 24px;
		border: 1px solid #e0e5ec;
		border-radius: 10px;
		background: #ffffff;
	}

.term-link {
	display: block;
	color: inherit;
	text-decoration: none;
	transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	cursor: pointer;
}

.term-link:hover {
	transform: translateY(-2px);
	border-color: #9aa9bd;
	box-shadow: 0 6px 18px rgba(19, 41, 75, 0.08);
}

	.term-card h3 {
		margin: 0;
		color: #13294b;
		font-size: 21px;
	}

	.term-card p {
		margin: 10px 0 0;
		color: #566176;
	}

	.term-card .english {
		margin-top: 2px;
		color: #8791a1;
		font-size: 13px;
	}

	footer {
		padding: 30px 0;
		border-top: 1px solid #e2e7ef;
		background: #ffffff;
		color: #697386;
		font-size: 13px;
	}

	@media (max-width: 650px) {
		.container {
			width: min(100% - 28px, 1080px);
		}

		.hero {
			padding: 60px 0 50px;
		}

		.term-grid {
			grid-template-columns: 1fr;
		}

		}
.home-search-form {
    display: flex;
    align-items: stretch;
    gap: 10px;
}

.home-search-form .search {
    flex: 1;
    width: 0;
    min-width: 0;
}

.home-search-form button {
    flex-shrink: 0;
    min-height: 52px;
    padding: 0 20px;
    border: none;
    border-radius: 8px;
    background: #17365d;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
}

.home-search-form button:hover {
    background: #244d7c;
}

@media (max-width: 650px) {
    .home-search-form {
        gap: 8px;
    }

    .home-search-form button {
        padding: 0 14px;
    }


	}
	
	@media (max-width: 650px) {
    h1 {
        font-size: clamp(24px, 7.5vw, 30px);
        letter-spacing: -0.02em;
    }
}

</style>