
---
import { getCollection } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

import { categories } from '../../data/categories';

const terms = await getCollection('terms');

const categoryList = Object.entries(categories).map(([id, category]) => ({
    id,
    name: category.name,
    description: category.description,
    count: terms.filter((term) =>
        term.data.categories.some((categoryId) => categoryId === id)
    ).length,
}));
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content="MLB用語をカテゴリ別に探せます。"
        />
        <title>カテゴリ一覧 | MLB用語辞典</title>
    </head>

    <body>
        <SiteHeader />

        <main class="category-page">
            <p class="breadcrumb">
                <a href="/">MLB用語辞典</a>
                <span>›</span>
                カテゴリ
            </p>

            <section class="intro">
                <p class="eyebrow">CATEGORY</p>
                <h1>カテゴリ一覧</h1>
                <p>MLB用語をカテゴリ別に探せます。</p>

                <p class="index-link">
                    <a href="/terms/">用語索引から探す →</a>
                </p> 
         </section>

            <div class="category-grid">
                {categoryList.map((category) =>
                    category.count > 0 ? (
                        <a
                            class="category-card"
                            href={`/categories/${category.id}/`}
                        >
                            <div class="card-heading">
                                <h2>{category.name}</h2>
                                <span>{category.count}語</span>
                            </div>
                            <p>{category.description}</p>
                        </a>
                    ) : (
                        <div class="category-card empty">
                            <div class="card-heading">
                                <h2>{category.name}</h2>
                                <span>0語</span>
                            </div>
                            <p>{category.description}</p>
                        </div>
                    )
                )}
            </div>
        </main>
        <SiteFooter />
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
        background: #f6f8fb;
        color: #172033;
        font-family: -apple-system, BlinkMacSystemFont,
            "Segoe UI", "Noto Sans JP", sans-serif;
        line-height: 1.7;
    }

    .category-page {
        width: min(1000px, calc(100% - 40px));
        margin: 0 auto;
        padding: 32px 0 80px;
    }

    .breadcrumb {
        margin: 0 0 40px;
        color: #64748b;
        font-size: 13px;
    }

    .breadcrumb a {
        color: #476b95;
        text-decoration: none;
    }

    .breadcrumb span {
        margin: 0 8px;
    }

    .intro {
        margin-bottom: 40px;
    }

    .eyebrow {
        margin: 0 0 14px;
        color: #476b95;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.1em;
    }

    h1 {
        margin: 0 0 22px;
        font-size: 38px;
    }

    .intro > p:last-child {
        color: #566176;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .category-card {
        display: block;
        padding: 26px;
        background: #ffffff;
        border: 1px solid #dbe3ed;
        border-radius: 12px;
        color: inherit;
        text-decoration: none;
    }

    a.category-card:hover {
        border-color: #8daac9;
        background: #fafdff;
    }

    .card-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    h2 {
        margin: 0;
        color: #17365d;
        font-size: 21px;
    }

    .card-heading span {
        color: #64748b;
        font-size: 13px;
        white-space: nowrap;
    }

    .category-card > p {
        margin: 14px 0 0;
        color: #566176;
        font-size: 14px;
    }

    .category-card.empty {
        opacity: 0.6;
    }

    @media (max-width: 650px) {
        .category-page {
            width: calc(100% - 28px);
            padding-top: 28px;
        }

        h1 {
            font-size: 30px;
        }

        .category-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .category-card {
            padding: 20px;
        }
    }

        .index-link a {
            color: #315d89;
            text-decoration: none;
            font-weight: 600;
        }

.index-link a:hover {
    text-decoration: underline;
}
    
</style>
