
---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const entries = await getCollection('terms');

const terms = entries.map((entry) => ({
    id: entry.id,
    name: entry.data.title.replace(/とは[？?]$/, '').trim(),
    english: entry.data.english ?? '',
    reading: entry.data.reading,
    description: entry.data.description,
}));
---

<html lang="ja">
    
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MLB用語辞典の用語を検索できます。" />
    <meta name="robots" content="noindex, follow" />
    <title>用語検索 | MLB用語辞典</title>
</head>


    <body>
        <SiteHeader />

        <main class="search-page">
            <p class="breadcrumb">
                <a href="/">MLB用語辞典</a>
                <span>›</span>
                用語検索
            </p>

            <section class="intro">
                <p class="eyebrow">SEARCH</p>
                <h1>用語検索</h1>
                <p>用語名・英語名・読み仮名から検索できます。</p>
            </section>

            <form action="/search/" method="get" class="search-form">
                <input
                    id="search-input"
                    type="search"
                    name="q"
                    placeholder="例：DFA、40人枠、Roster"
                    aria-label="MLB用語を検索"
                    autocomplete="off"
                />
                <button type="submit">検索</button>
            </form>

            <p id="result-count" aria-live="polite">
                キーワードを入力してください。
            </p>

            <div class="results">
                {terms.map((term) => (
                    <a
                        class="result-card"
                        href={`/terms/${term.id}/`}
                        data-search={`${term.name} ${term.english} ${term.reading}`}
                        hidden
                    >
                        <div class="term-heading">
                            <h2>{term.name}</h2>
                            {term.english && (
                                <span>{term.english}</span>
                            )}
                        </div>
                        <p>{term.description}</p>
                    </a>
                ))}
            </div>

            <p id="no-results" hidden>
                一致する用語がありませんでした。
            </p>
        </main>

        <script>
            const input = document.querySelector<HTMLInputElement>('#search-input');
            const count = document.querySelector<HTMLElement>('#result-count');
            const noResults = document.querySelector<HTMLElement>('#no-results');
            const cards = Array.from(
                document.querySelectorAll<HTMLAnchorElement>('.result-card')
            );

            function normalize(value: string) {
                return value
                    .normalize('NFKC')
                    .toLowerCase()
                    .replace(/[ァ-ヶ]/g, (char) =>
                        String.fromCharCode(char.charCodeAt(0) - 0x60)
                    )
                    .replace(/[\s\-_.]/g, '');
            }

            if (input && count && noResults) {
                const params = new URLSearchParams(window.location.search);
                input.value = params.get('q') ?? '';

                function updateResults() {
                    if (!input || !count || !noResults) return;

                    const query = normalize(input.value.trim());
                    let matches = 0;

                    for (const card of cards) {
                        const keywords = normalize(card.dataset.search ?? '');
                        const found = query.length > 0 && keywords.includes(query);

                        card.hidden = !found;

                        if (found) {
                            matches++;
                        }
                    }

                    count.textContent = query
                        ? `${matches}件の用語が見つかりました。`
                        : 'キーワードを入力してください。';

                    noResults.hidden = !query || matches > 0;
                }



                updateResults();
            }
        </script>
        <SiteFooter />
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
        background: #f6f8fb;
        color: #172033;
        font-family: -apple-system, BlinkMacSystemFont,
            "Segoe UI", "Noto Sans JP", sans-serif;
        line-height: 1.8;
    }

    .search-page {
        width: min(900px, calc(100% - 40px));
        margin: 0 auto;
        padding: 32px 0 80px;
    }

    .breadcrumb {
        margin-bottom: 40px;
        font-size: 13px;
        color: #64748b;
    }

    .breadcrumb a {
        color: #476b95;
        text-decoration: none;
    }

    .breadcrumb span {
        margin: 0 8px;
    }

    .intro {
        margin-bottom: 32px;
    }

    .eyebrow {
        color: #476b95;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.1em;
    }

    h1 {
        margin: 12px 0 20px;
        font-size: 38px;
    }

    .intro > p:last-child {
        color: #566176;
    }

    .search-form {
        display: flex;
        gap: 10px;
        margin-bottom: 24px;
    }

    .search-form input {
        flex: 1;
        min-width: 0;
        padding: 14px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 16px;
    }

    .search-form button {
        padding: 12px 22px;
        border: none;
        border-radius: 8px;
        background: #17365d;
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

    #result-count {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 24px;
    }

    .results {
        display: grid;
        gap: 14px;
    }

    .result-card {
        display: block;
        padding: 24px;
        background: white;
        border: 1px solid #dbe3ed;
        border-radius: 12px;
        color: inherit;
        text-decoration: none;
    }

    .result-card[hidden],
    #no-results[hidden] {
        display: none;
    }

    .result-card:hover {
        border-color: #8daac9;
        background: #fafdff;
    }

    .term-heading {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 8px 16px;
    }

    .term-heading h2 {
        margin: 0;
        color: #17365d;
        font-size: 21px;
    }

    .term-heading span {
        color: #8791a1;
        font-size: 14px;
    }

    .result-card > p {
        margin: 12px 0 0;
        color: #566176;
        font-size: 15px;
    }

    @media (max-width: 650px) {
        .search-page {
            width: calc(100% - 28px);
        }

        h1 {
            font-size: 30px;
        }

        .search-form button {
            padding: 12px 16px;
        }

        .result-card {
            padding: 20px;
        }
    }
</style>
