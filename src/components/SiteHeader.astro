---
const pathname = Astro.url.pathname;

const isHome = pathname === '/';
const isTerms = pathname.startsWith('/terms');
const isCategories = pathname.startsWith('/categories');
const isContact = pathname.startsWith('/contact');
---

<header class="site-header">
    <div class="site-header-inner">
        <a class="site-logo" href="/">
            MLB用語辞典
        </a>

        

<nav class="site-nav" aria-label="メインナビゲーション">
    <a
        href="/"
        class:list={['nav-link', { active: isHome }]}
    >
        トップ
    </a>

    <a
        href="/terms/"
        class:list={['nav-link', { active: isTerms }]}
    >
        用語索引
    </a>

    <a
        href="/categories/"
        class:list={['nav-link', { active: isCategories }]}
    >
        カテゴリ
    </a>

    <a
        href="/contact/"
        class:list={['nav-link', { active: isContact }]}
    >
        お問い合わせ
    </a>
</nav>


    </div>
</header>

<style>
    .site-header {
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
    }

    .site-header-inner {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .site-logo {
        color: #17365d;
        font-size: 20px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .site-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-link {
        padding: 8px 12px;
        border-radius: 6px;
        color: #566176;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .nav-link:hover {
        background: #f1f5f9;
        color: #17365d;
    }

    .nav-link.active {
        background: #eaf2f9;
        color: #17365d;
    }

    
@media (max-width: 650px) {
    .site-header-inner {
        width: calc(100% - 28px);
        min-height: 0;
        padding: 12px 0 10px;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .site-logo {
        font-size: 18px;
    }



.site-nav {
    display: grid;
    grid-template-columns: 0.8fr 1fr 1fr 1.5fr;
    width: 100%;
    height: 44px;
    gap: 4px;
    padding: 0;
    margin: 0;
}

.nav-link {
    flex: unset;
    min-width: 0;
    min-height: 0;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2px;
    font-size: 12px;
    white-space: nowrap;
}

}

</style>