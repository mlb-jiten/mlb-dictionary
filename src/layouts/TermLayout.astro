---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
    title: string;
    english?: string;
    description: string;
    updated: Date;
}

const {
    title,
    english,
    description,
    updated,
} = Astro.props;

const updatedText = updated.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <title>{title} | MLB用語辞典</title>
    </head>

    <body>
        <SiteHeader />

        <main class="container">
            <p class="breadcrumb">
                <a href="/">MLB用語辞典</a>
                <span>›</span>
                {title}
            </p>

            <article>
                {english && <p class="english">{english}</p>}

                <h1>{title}</h1>

                <p class="lead">{description}</p>

                <div class="term-content">
                    <slot />
                </div>

                <p class="update">
                    最終更新：{updatedText}
                </p>
            </article>
        </main>
        <SiteFooter />
    </body>
</html>




<style is:global>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f6f8fb;
        color: #172033;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
            "Noto Sans JP", sans-serif;
        line-height: 1.8;
    }

    .container {
        width: min(800px, calc(100% - 36px));
        margin: 0 auto;
    }



    main {
        padding-top: 28px;
        padding-bottom: 70px;
    }

    .breadcrumb {
        margin: 0 0 22px;
        color: #64748b;
        font-size: 13px;
    }

    .breadcrumb a {
        color: #476b95;
        text-decoration: none;
    }

    .breadcrumb span {
        margin: 0 8px;
    }

    article {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 40px;
    }

    .english {
        margin: 0 0 8px;
        color: #64748b;
        font-size: 14px;
    }

    h1 {
        margin: 0 0 18px;
        font-size: 32px;
        line-height: 1.4;
    }

    .lead {
        margin: 0 0 32px;
        padding: 16px 20px;
        background: #f0f5fa;
        border-left: 4px solid #315d89;
        border-radius: 4px;
        font-size: 16px;
    }

    .term-content p {
        margin: 0 0 20px;
        font-size: 16px;
        line-height: 2;
    }

    .term-content h2 {
        margin: 44px 0 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e2e8f0;
        font-size: 23px;
        line-height: 1.5;
    }

    .term-content h3 {
        margin: 32px 0 16px;
        font-size: 19px;
        line-height: 1.5;
    }

    .update {
        margin-top: 48px;
        padding-top: 18px;
        border-top: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 13px;
    }

    @media (max-width: 600px) {
        article {
            padding: 24px 20px;
        }

        h1 {
            font-size: 27px;
        }

        .term-content h2 {
            font-size: 21px;
        }

        .term-content p {
            font-size: 15px;
        }
    }

.term-content a,
.term-content a:visited {
    color: #315d89;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
}

.term-content a:hover {
    color: #17365d;
    text-decoration-thickness: 2px;
}

.term-content a:focus-visible {
    outline: 2px solid #315d89;
    outline-offset: 3px;
}

</style>